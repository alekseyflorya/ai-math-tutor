# Copy to .env and fill in. Used by local dev (pnpm dev) and by docker compose.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=tutor
# Local dev (pnpm dev) connects to the db container on localhost.
# docker compose builds its own URL from the POSTGRES_* values above.
DATABASE_URL=postgres://tutor:tutor@localhost:5433/tutor

# --- Auth -------------------------------------------------------------------
# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# true behind HTTPS (production); false for http://localhost
COOKIE_SECURE=false

# --- AI model ---------------------------------------------------------------
# gemini | anthropic   (mock exists only for automated tests)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Comma-separated: primary model, then fallbacks used when it times out or is overloaded.
# Available ids: curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# One model call / all model calls of one student turn (ms)
LLM_TIMEOUT_MS=15000
LLM_TURN_BUDGET_MS=25000

# Daily caps that protect the AI quota on a public demo
LLM_DAILY_LIMIT_PER_USER=150
LLM_DAILY_LIMIT_GLOBAL=1000

# --- Deployment (docker-compose.prod.yml) -----------------------------------
# Public hostname served by Caddy (gets a Let's Encrypt certificate automatically)
DOMAIN=tutor.florik.pp.ua
# Images come from GHCR (see docker-compose.prod.yml); CI sets IMAGE_TAG to the commit SHA.
