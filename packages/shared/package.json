{
  "name": "@tutor/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Math engine (safe linear-equation parser/solver/step checker) and API contracts shared by web and api.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "mathjs": "^15.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
